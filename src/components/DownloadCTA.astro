---
import { ArrowUpRight } from 'lucide-astro';
import DownloadButton from './DownloadButton.astro';
import { site, type Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="download-cta shell section-grid" data-reveal>
  <div>
    <span class="eyebrow">{t.home.cta.label}</span>
    <h2 class="display">{t.home.cta.title}</h2>
  </div>
  <div class="cta-action">
    <p>{t.home.cta.text}</p>
    <div class="button-row">
      <DownloadButton locale={locale} />
      <a class="text-link" href={site.repository}>
        GitHub
        <ArrowUpRight aria-hidden="true" size={16} />
      </a>
    </div>
    <p class="fine-print">{t.common.note}</p>
  </div>
</section>
