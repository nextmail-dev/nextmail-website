---
import { ArrowUpRight } from 'lucide-astro';
import Brand from './Brand.astro';
import { site, href, type Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="site-footer shell">
  <div class="footer-top">
    <div class="footer-brand">
      <a href={href(locale)} aria-label="NextMail">
        <Brand />
      </a>
      <p>{t.footer.line}</p>
      <span class="mono">{t.footer.credit}</span>
    </div>
    <div>
      <h2>{t.footer.product}</h2>
      <a href={href(locale, 'features')}>{t.nav.features}</a>
      <a href={href(locale, 'download')}>{t.nav.download}</a>
      <a href={href(locale, 'changelog')}>{t.nav.changelog}</a>
    </div>
    <div>
      <h2>{t.footer.resources}</h2>
      <a href={href(locale, 'docs')}>{t.footer.handbook}</a>
      <a href={href(locale, 'docs/security')}>{t.docs.categories[3]}</a>
      <a href={href(locale, 'docs/faq')}>{t.docs.categories[4]}</a>
    </div>
    <div>
      <h2>{t.footer.project}</h2>
      <a href={site.repository}>
        {t.footer.source}
        <ArrowUpRight aria-hidden="true" size={12} />
      </a>
      <a href={site.issues}>
        {t.footer.issues}
        <ArrowUpRight aria-hidden="true" size={12} />
      </a>
      <a href={site.releases}>
        GitHub Releases
        <ArrowUpRight aria-hidden="true" size={12} />
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getUTCFullYear()} NextMail</span>
    <span>{t.footer.notice}</span>
    <a href="#top">
      ↑{' '}
      <span class="sr-only">
        {locale === 'en' ? 'Back to top' : '回到顶部'}
      </span>
    </a>
  </div>
</footer>
