---
import '@fontsource-variable/dm-sans';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, href, type Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title
  ? `${title} — NextMail`
  : `NextMail — ${t.home.subtitle}`;
const pageDescription = description || t.home.description;
const path = Astro.url.pathname
  .replace(/^\/zh-CN(?=\/|$)/, '')
  .replace(/^\/|\/$/g, '');
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={locale} id="top" data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(href('en', path), site.url)}
        />
        <link
          rel="alternate"
          hreflang="zh-CN"
          href={new URL(href('zh-CN', path), site.url)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(href('en', path), site.url)}
        />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NextMail" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta
      property="og:image"
      content={`${site.url}/brand/og-${locale === 'en' ? 'en' : 'zh'}.png`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.home.subtitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="twitter:image"
      content={`${site.url}/brand/og-${locale === 'en' ? 'en' : 'zh'}.png`}
    />
    <script is:inline>
      (() => {
        let theme = 'system';
        try {
          theme = localStorage.getItem('nextmail-theme') || 'system';
        } catch {
          /* Storage can be disabled. */
        }
        document.documentElement.dataset.theme = ['light', 'dark'].includes(
          theme,
        )
          ? theme
          : 'system';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.common.skip}
    </a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
