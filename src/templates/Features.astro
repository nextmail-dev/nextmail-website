---
import {
  ArrowRight,
  FilePenLine,
  FileText,
  Send,
  Users,
  Folder,
  Star,
  Inbox,
  ShieldCheck,
  KeyRound,
  ImageOff,
  AppWindow,
  SunMoon,
  Bell,
} from 'lucide-astro';
import FeatureRow from '../components/FeatureRow.astro';
import SyncStory from '../components/SyncStory.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import { href, type Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const zh = locale === 'zh-CN';
---

<div class="shell">
  <section class="page-heading">
    <span class="eyebrow">{t.features.label}</span>
    <h1 class="display">{t.features.title}</h1>
    <p>{t.features.description}</p>
  </section>
  <nav class="anchor-nav" aria-label={t.features.jump}>
    {['reading', 'writing', 'folders', 'desktop'].map((id, i) => (
      <a href={`#${id}`}>
        <span class="mono">0{i + 1}</span>
        {t.features.sections[i]}
        <ArrowRight aria-hidden="true" size={13} />
      </a>
    ))}
  </nav>
  <div id="reading">
    <FeatureRow locale={locale} />
  </div>
  <section class="feature-row" id="writing" data-reveal>
    <div class="feature-copy">
      <span class="eyebrow">02 / {t.features.sections[1]}</span>
      <h2 class="display">{t.features.writingTitle}</h2>
      <p>{t.features.writingText}</p>
      <a class="text-link" href={href(locale, 'docs/accounts')}>
        {t.docs.categories[1]}
        <ArrowRight aria-hidden="true" size={16} />
      </a>
    </div>
    <figure class="workflow-visual">
      <figcaption class="eyebrow">{t.features.writingDemo}</figcaption>
      <div class="workflow-sources">
        <span>
          <FileText aria-hidden="true" size={20} />
          {t.features.draft}
        </span>
        <span>
          <FilePenLine aria-hidden="true" size={20} />
          {t.features.template}
        </span>
        <span>
          <Users aria-hidden="true" size={20} />
          {zh ? '联系人分组' : 'Contact groups'}
        </span>
      </div>
      <div class="workflow-connector"></div>
      <div class="workflow-composer">
        <FilePenLine aria-hidden="true" size={24} />
        <strong>{t.features.compose}</strong>
        <span class="mono">To / Cc / Bcc</span>
        <div class="demo-line"></div>
        <div class="demo-line short"></div>
      </div>
      <div class="workflow-connector"></div>
      <span class="workflow-send">
        <Send aria-hidden="true" size={16} />
        {t.features.send}
      </span>
    </figure>
  </section>
  <section class="feature-row reverse" id="folders" data-reveal>
    <div class="feature-copy">
      <span class="eyebrow">03 / {t.features.sections[2]}</span>
      <h2 class="display">{t.features.foldersTitle}</h2>
      <p>{t.features.foldersText}</p>
    </div>
    <figure class="folder-visual">
      <figcaption class="eyebrow">
        {zh
          ? '账户内的整理方式 · 示意图'
          : 'Organization within an account · schematic'}
      </figcaption>
      <div>
        <Inbox aria-hidden="true" size={21} />
        <span>{zh ? '收件箱' : 'Inbox'}</span>
        <span class="mono">01</span>
      </div>
      <div>
        <Star aria-hidden="true" size={21} />
        <span>{zh ? '星标邮件' : 'Starred'}</span>
        <span class="mono">02</span>
      </div>
      <div>
        <Folder aria-hidden="true" size={21} />
        <span>{zh ? '自己的文件夹' : 'Your folders'}</span>
        <span class="mono">03</span>
      </div>
      <p class="fine-print">
        {zh
          ? '收藏 · 多选 · 拖放 · 批量操作'
          : 'Favorites · Multi-select · Drag & drop · Batch actions'}
      </p>
    </figure>
  </section>
  <section class="detail-grid" id="desktop">
    <article data-reveal>
      <div class="detail-icons">
        <AppWindow aria-hidden="true" size={23} />
        <SunMoon aria-hidden="true" size={23} />
        <Bell aria-hidden="true" size={23} />
      </div>
      <h2 class="display">{t.features.desktopTitle}</h2>
      <p>{t.features.desktopText}</p>
    </article>
    <article data-reveal>
      <div class="detail-icons">
        <ShieldCheck aria-hidden="true" size={23} />
        <KeyRound aria-hidden="true" size={23} />
        <ImageOff aria-hidden="true" size={23} />
      </div>
      <h2 class="display">{t.features.securityTitle}</h2>
      <p>{t.features.securityText}</p>
      <a class="text-link" href={href(locale, 'docs/security')}>
        {t.docs.categories[3]}
        <ArrowRight aria-hidden="true" size={16} />
      </a>
    </article>
  </section>
  <aside class="notice limits">
    <ShieldCheck aria-hidden="true" size={22} />
    <div>
      <h2>{t.features.limitsTitle}</h2>
      <p>{t.features.limitsText}</p>
    </div>
  </aside>
</div>
<SyncStory locale={locale} />
<DownloadCTA locale={locale} />
